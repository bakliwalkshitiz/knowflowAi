# Spring Boot Backend Environment Variables Example
# Copy this file to .env and customize for your environment

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/knowflow_ai
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# OpenAI API Key (Optional if users provide their key via UI)
OPENAI_API_KEY=sk-your-openai-api-key-here

# JWT Configuration (Must be at least 256 bits / 32 characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_here
JWT_EXPIRATION_MS=86400000

# CORS Origins (Comma separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-production-app.vercel.app
